    {
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "jsCode": "// Obtener los datos del tweet (link y tweet AI) de la entrada anterior.\n// Asumimos que los datos del tweet llegan como el primer ítem de $input.\nconst inputData = $input.first().json;\nconst newTweetLink = inputData.link;\nconst newTweetText = inputData.tweet;\n\n// --- EXTRACCIÓN DE DATOS DE GOOGLE SHEETS ---\n// Obtenemos todos los ítems del nodo 'Get Data'. Cada ítem contiene la propiedad 'json' con los datos de la fila.\nconst sheetItems = $('Get Data').all();\n// Nos aseguramos de que sheetData sea siempre un array para evitar errores con .some()\nconst sheetData = Array.isArray(sheetItems) ? sheetItems : [];\n// --- FIN EXTRACCIÓN DE DATOS DE GOOGLE SHEETS ---\n\n// Franjas horarias prioritarias (en formato HH:MM)\nconst timeSlots = ['07:59', '09:59', '12:59', '17:59', '20:59'];\n\n// Obtener la fecha y hora actual en la zona horaria de Madrid.\n// Hoy es 15 de julio de 2025.\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Madrid' }));\nnow.setSeconds(0);\nnow.setMilliseconds(0);\n\nlet scheduledTime = null;\nconst MAX_DAYS_TO_SEARCH = 7; // Limitar la búsqueda a los próximos 7 días.\n\nfor (let i = 0; i < MAX_DAYS_TO_SEARCH; i++) {\n    const currentDate = new Date(now);\n    currentDate.setDate(now.getDate() + i);\n    currentDate.setHours(0, 0, 0, 0); // Resetear la hora a medianoche para solo comparar el día.\n\n    for (const slot of timeSlots) {\n        const [hour, minute] = slot.split(':').map(Number);\n        const candidateDateTime = new Date(currentDate);\n        candidateDateTime.setHours(hour, minute, 0, 0); // Establecer la hora para la franja candidata.\n\n        // Si la franja horaria candidata ya pasó HOY, la saltamos y seguimos.\n        if (candidateDateTime <= now) {\n            continue;\n        }\n\n        // --- LÓGICA PARA VERIFICAR SI LA FRANJA ESTÁ OCUPADA ---\n        const isOccupied = sheetData.some(item => {\n            // Acceder al objeto 'json' dentro de cada 'item' devuelto por .all().\n            const rowData = item.json;\n\n            // Verificar que 'rowData' y 'rowData.Fecha' existan.\n            if (!rowData || !rowData.Fecha) {\n                return false;\n            }\n            // Parsear la fecha de la hoja.\n            const sheetDateTime = new Date(rowData.Fecha);\n\n            // NORMALIZAR AMBAS FECHAS A UN FORMATO COMPARABLE (Año, Mes, Día, Hora, Minuto).\n            // Esto elimina la variabilidad de segundos y milisegundos que puede causar errores.\n            const normalizedSheetDate = new Date(\n                sheetDateTime.getFullYear(),\n                sheetDateTime.getMonth(),\n                sheetDateTime.getDate(),\n                sheetDateTime.getHours(),\n                sheetDateTime.getMinutes()\n            );\n\n            const normalizedCandidateDate = new Date(\n                candidateDateTime.getFullYear(),\n                candidateDateTime.getMonth(),\n                candidateDateTime.getDate(),\n                candidateDateTime.getHours(),\n                candidateDateTime.getMinutes()\n            );\n\n            // Comparar las fechas normalizadas y el estado.\n            // Solo se considera \"ocupado\" si el estado es 'PROGRAMADO'.\n            return normalizedSheetDate.getTime() === normalizedCandidateDate.getTime() && rowData.Estado === 'PROGRAMADO';\n        });\n        // --- FIN LÓGICA PARA VERIFICAR SI LA FRANJA ESTÁ OCUPADA ---\n\n        // Si la franja no está ocupada, la hemos encontrado.\n        if (!isOccupied) {\n            scheduledTime = candidateDateTime;\n            break; // Salir del bucle de franjas horarias.\n        }\n    }\n\n    if (scheduledTime) {\n        break; // Salir del bucle de días si ya encontramos una franja.\n    }\n}\n\n// --- DEVOLUCIÓN DEL RESULTADO ---\nif (scheduledTime) {\n    return [{\n        json: {\n            link: newTweetLink,\n            tweet: newTweetText,\n            // Formato 'AAAA-MM-DD HH:MM:SS' para Google Sheets.\n            fechaProgramada: scheduledTime.toISOString().replace('T', ' ').substring(0, 19),\n            status: 'success',\n            message: `Mensaje programado para ${scheduledTime.toISOString().replace('T',' ').substring(0,19) }`\n        }\n    }];\n} else {\n    // Si no se encontró espacio.\n    return [{\n        json: {\n            link: newTweetLink,\n            tweet: newTweetText,\n            status: 'error',\n            message: 'No se encontraron franjas horarias disponibles en los próximos días.'\n        }\n    }];\n}"
      }
    },
