      }
    },
    {
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1) Carga el store estático (por nodo)\nconst staticStore = await $getWorkflowStaticData('node');\nstaticStore.pages = staticStore.pages || {};\n\n// 2) Extrae URL y HTML del item actual\nconst url  = $json.url;\nconst html = $json.html;\n\n// 3) Obtén el HTML anterior (o cadena vacía si no hay)\nconst lastHtml = staticStore.pages[url] || '';\n\n// 4) Normaliza y parte en líneas\nconst normalize = (s) =>\n  s\n    .split(/\\r?\\n/)       // por saltos de línea\n    .map((l) => l.trim()) // quita espacios a los lados\n    .filter((l) => l);    // elimina líneas vacías\n\nconst oldLines = normalize(lastHtml);\nconst newLines = normalize(html);\n\n// 5) Calcula añadidos y eliminados\nconst added   = newLines.filter((l) => !oldLines.includes(l));\nconst removed = oldLines.filter((l) => !newLines.includes(l));\n\n// 6) Marca cambio (solo si no es la primera pasada)\nconst changed = lastHtml !== '' && (added.length > 0 || removed.length > 0);\n\n// 7) Guarda para la próxima ejecución\nstaticStore.pages[url] = html;\n\n// 8) Devuelve un objeto (modo Run for Each Item)\nreturn {\n  json: {\n    url,\n    changed,\n    added,    // líneas nuevas\n    removed, \n    html,\n    lastHtml// líneas que ya no aparecen\n  }\n};\n"
      }
    },
    {
      "name": "If",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -180,
        140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "31845ae1-df64-4c00-b24b-18fb3ea1bfd8",
              "leftValue": "={{ $json.changed }}",
              "rightValue": "null",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
