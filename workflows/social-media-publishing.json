      "typeVersion": 4.2,
      "position": [
        560,
        100
      ],
      "parameters": {
        "url": "https://cdn.syndication.twimg.com/tweet-result",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ $json.tweetId }}"
            },
