    {
      "name": "Edit Fields1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        -100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "45ea4ae8-be03-485b-95eb-539c041b211a",
              "name": "html",
              "value": "={{ $json.stdout.parseJson().stable }}",
              "type": "string"
            },
            {
              "id": "cac86666-582a-48e0-bc67-27665360b94f",
              "name": "url",
              "value": "={{ $json.stdout.parseJson().url }}",
              "type": "string"
